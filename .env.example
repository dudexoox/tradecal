# Local development (embedded Postgres)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Supabase / Vercel (hosted). Use the *pooler* URI (port 6543) for serverless.
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_ANON_KEY=<anon (public) key — needed by Supabase Auth>
SUPABASE_SERVICE_ROLE_KEY=<service-role key>
SUPABASE_UPLOAD_BUCKET=journal-uploads

# Desktop MT5 sync agent target (Supabase pooler URI)
SUPABASE_DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Optional local bridge overrides (desktop only)
# MT5_PYTHON=C:\Users\<you>\AppData\Local\ForexJournal\bridge-venv\Scripts\python.exe
# MT5_BRIDGE_SCRIPT=...\obsidian-forex-journal\.obsidian\plugins\forex-journal\bridge\mt5_bridge.py
# MT5_TERMINAL=C:\Users\<you>\AppData\Local\ForexJournal\MT5-Terminal\terminal64.exe
